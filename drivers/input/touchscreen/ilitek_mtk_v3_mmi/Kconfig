config INPUT_TOUCHSCREEN_ILITEK_MTK_V3_MMI
	bool "Support Motorola MediaTek ilitek touch screen"
	depends on TOUCHSCREEN_MTK
	select TOUCHSCREEN_MMI_PANELINFO
	help
	  Say Y here if you wish to enable the ilitek touch
	  screen driver.

	  If unsure, say N.

config INPUT_TOUCHSCREEN_ILITEK_MTK_V3_MMI_CHARGE_DETECT
	bool "Support charge detect for ilitek_mtk_v3_mmi driver"
	depends on INPUT_TOUCHSCREEN_ILITEK_MTK_V3_MMI
	help
	  Say Y here if you wish to enable charger detection
	  for ilitek_mtk_v3_mmi driver.

	  If unsure, say N.

config INPUT_TOUCHSCREEN_ILITEK_MTK_V3_MMI_GESTURE
	bool "Support gesture detect for ilitek_mtk_v3_mmi driver"
	depends on INPUT_TOUCHSCREEN_ILITEK_MTK_V3_MMI
	help
	  Say Y here if you wish to enable gesture detection
	  for ilitek_mtk_v3_mmi driver.

	  If unsure, say N.
