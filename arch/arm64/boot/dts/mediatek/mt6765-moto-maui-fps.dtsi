&pio {
	fps_irq: fps_irq {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO14__FUNC_GPIO14>;
			slew-rate = <0>;
			bias-disable;
		};
	};

	fps_reset_high: fps_reset_high {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO170__FUNC_GPIO170>;
			slew-rate = <1>;
			output-high;
		};
	};

	fps_reset_low: fps_reset_low {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO170__FUNC_GPIO170>;
			slew-rate = <1>;
			output-low;
		};
	};
};

&odm {
	fingerprint_int: fingerprint_int {
		compatible = "mediatek,fingerprint-fpc";
		fpc,enable-wakeup;
		interrupt-parent = <&pio>;
		interrupts = <14 IRQ_TYPE_EDGE_RISING 14 0>;
		pinctrl-names = "fingerprint_irq", "fingerprint_reset_high", "fingerprint_reset_low";
		pinctrl-0 = <&fps_irq>;
		pinctrl-1 = <&fps_reset_high>;
		pinctrl-2 = <&fps_reset_low>;
		fpc,rst= <&pio 170 0>;
		fpc,irq = <&pio 14 0>;
		status = "okay";
	};

	goodix_int: goodix_int {
		compatible = "mediatek,fingerprint-goodix";
		interrupt-parent = <&pio>;
		interrupts = <14 IRQ_TYPE_EDGE_RISING 14 0>;
		pinctrl-names = "fingerprint_irq", "fingerprint_reset_high", "fingerprint_reset_low";
		pinctrl-0 = <&fps_irq>;
		pinctrl-1 = <&fps_reset_high>;
		pinctrl-2 = <&fps_reset_low>;
		int-gpios = <&pio 14 0>;
		status = "okay";
	};
};

&spi1 {
	#address-cells = <1>;
	#size-cells = <0>;
	mediatek,pad-select = <0>, <1>;
	tee-only;
	fpc_tee@0 {
		compatible = "fpc,fpc_spi";
		reg = <0>;
		fpc,enable-wakeup;
		spi-max-frequency = <8000000>;
		netlink-event = <31>;
		status = "okay";
	};

	goodix_tee@1 {
		status = "okay";
		compatible = "goodix,goodix-fp";
		reg = <1>;
		spi-max-frequency = <8000000>;
		netlink-event = <30>;
	};
};
