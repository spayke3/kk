CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE_NAMES="mediatek/mt6765-tonga-evb-overlay"
CONFIG_CUSTOM_KERNEL_IMGSENSOR="mot_tonga_s5k4h7_mipi_raw mot_tonga_ov02b1b_mipi_raw mot_tonga_gc02m1_mipi_raw mot_tonga_s5kjn1sq_mipi_raw mot_tonga_gc02m1b_mipi_raw"
CONFIG_CUSTOM_KERNEL_LCM="dsi_panel_mot_mipi_vid_boe_nt36525c_652_hdp dsi_panel_mot_mipi_vid_tm_ili9883a_652_hdp dsi_panel_mot_mipi_vid_tm_icnl9916_652_hdp dsi_panel_mot_mipi_vid_txd_icnl9911c_652_hdp"
