# CONFIG_MOTO_CAMGEST is not set
# CONFIG_MOTO_OFFBODY is not set
CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE_NAMES="mediatek/mt6765-maui-evb-overlay"
CONFIG_CUSTOM_KERNEL_IMGSENSOR="mot_maui_hi1634b_mipi_raw mot_maui_s5k5e9_mipi_raw mot_maui_gc02m1_mipi_raw mot_maui_ov02b10_mipi_raw"
CONFIG_CUSTOM_KERNEL_LCM="dsi_panel_mot_mipi_vid_tm_icnl9911c_652_hdp dsi_panel_mot_mipi_vid_hlt_ft8006s_652_hdp"
CONFIG_INPUT_TOUCHSCREEN_FTS_MTK_V3_MMI=y
CONFIG_INPUT_TOUCHSCREEN_ICNL9916_TDDI_MMI=y
CONFIG_LCM_HEIGHT="1600"
CONFIG_LCM_NOTIFIY_SUPPORT=y
CONFIG_LCM_WIDTH="720"
CONFIG_MOTO_ALGO_PARAMS=y
CONFIG_MOTO_ALGO=y
CONFIG_MOTO_ALSPS=y
CONFIG_MOTO_CHG_TCMD_SUPPORT=y
CONFIG_MOTO_CHOPCHOP=y
CONFIG_MOTO_FLATDOWN=y
CONFIG_MOTO_FLATUP=y
CONFIG_MOTO_FTM=y
CONFIG_MOTO_GLANCE=y
CONFIG_MOTO_LTS=y
CONFIG_MOTO_LTV=y
CONFIG_MOTO_MAUI_PROJECT_SWTP_SETING_APART=y
CONFIG_MOTO_STOWED=y
CONFIG_MTK_HIGH_FRAME_RATE=y
CONFIG_MTK_MD1_SUPPORT=9
